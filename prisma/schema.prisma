// Nordverkehr Bewerbungsportal – Datenmodell (PostgreSQL, z. B. Neon)
// Nach jeder Änderung: `npm run db:migrate:new -- <name>` (legt eine Migration
// in prisma/migrations an). Beim Deploy spielt `npm run build` sie automatisch ein.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PositionStatus {
  OPEN
  CLOSED
  HIDDEN
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  CHECKBOX
  URL
  FILE
  SCENARIO
  /// Regel-Quiz: eine Option ist richtig (nur serverseitig bekannt)
  QUIZ
}

enum VoteValue {
  PRO
  CONTRA
  ABSTAIN
}

enum MessageDirection {
  TEAM_TO_APPLICANT
  APPLICANT_TO_TEAM
  SYSTEM
  /// Automatische KI-Antwort, wenn kein Teammitglied online ist
  AI_TO_APPLICANT
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  DM_CLOSED
  NOT_SENT
}

enum TemplateCategory {
  EINGANG
  RUECKFRAGE
  EINLADUNG
  ANNAHME
  ABLEHNUNG
  ERINNERUNG
  SONSTIGES
}

enum OutboxType {
  DM
  CHANNEL_MESSAGE
  ADD_ROLE
  REMOVE_ROLE
  SET_NICK
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Nutzer & Zugriff
// ─────────────────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  discordId        String   @unique
  username         String
  globalName       String?
  avatar           String?
  discordCreatedAt DateTime
  // Erhöhen = alle Sitzungen dieses Nutzers sofort ungültig
  sessionVersion   Int      @default(0)

  // Rollen-Cache (kurzlebig, siehe src/lib/auth/access.ts)
  inGuild       Boolean   @default(false)
  isTeam        Boolean   @default(false)
  /// Abwesend (Urlaub o. Ä.) bis: keine automatische Zuteilung, keine Claim-Erinnerung/Morgen-DM
  awayUntil     DateTime?
  isAdmin       Boolean   @default(false)
  guildJoinedAt DateTime?
  roleCheckedAt DateTime?

  lastLoginAt        DateTime?
  /// Letzte Aktivität im Team-Bereich (für "Team online?")
  lastTeamActiveAt   DateTime?
  /// Möchte per DM Bescheid bekommen, wenn eine Stelle (wieder) öffnet
  notifyNewPositions Boolean   @default(false)
  /// Teammitglied möchte keine persönliche Morgen-DM mit seinen offenen Punkten
  digestOptOut       Boolean   @default(false)
  /// Testbewerber (Admin → Testbewerbungen) – kein echter Discord-Account
  isTest             Boolean   @default(false)
  /// Discord-Rollen (Cache aus der Rollenprüfung) – für Zuständigkeit pro Stelle
  roleIds            String[]  @default([])
  /// Geheimer Schlüssel fürs Kalender-Abo (Gespräche als .ics)
  calendarToken      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  applications       Application[]     @relation("Applicant")
  decisions          Application[]     @relation("Decider")
  claims             Application[]     @relation("Claimer")
  votes              Vote[]
  comments           Comment[]
  messages           Message[]
  statusChanges      StatusChange[]
  uploads            Upload[]
  notesAbout         UserNote[]        @relation("NoteSubject")
  notesWritten       UserNote[]        @relation("NoteAuthor")
  bansAbout          UserBan[]         @relation("BanSubject")
  bansCreated        UserBan[]         @relation("BanCreator")
  bansLifted         UserBan[]         @relation("BanLifter")
  templates          MessageTemplate[]
  auditLogs          AuditLog[]
  aiUsage            AiUsage[]
  profile            ApplicantProfile?
  ratings            Rating[]
  slotsCreated       InterviewSlot[]   @relation("SlotCreator")
  interviewNotes     InterviewNote[]   @relation("InterviewNoteAuthor")
  interviewChecks    InterviewCheck[]  @relation("InterviewCheckAuthor")
  suggestions        Suggestion[]      @relation("SuggestionAuthor")
  suggestionsHandled Suggestion[]      @relation("SuggestionHandler")
}

/// Allgemeine Angaben eines Bewerbers (einmal ausgefüllt, für weitere Bewerbungen wiederverwendet).
/// answers: { [Fragen-Key]: Wert } – Keys statt IDs, damit Umbauten im Formular nichts kaputt machen.
model ApplicantProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age       Int?
  answers   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNote {
  id        String   @id @default(cuid())
  subjectId String
  subject   User     @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([subjectId])
}

model UserBan {
  id          String    @id @default(cuid())
  subjectId   String
  subject     User      @relation("BanSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reason      String
  expiresAt   DateTime?
  createdById String?
  createdBy   User?     @relation("BanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  liftedAt    DateTime?
  liftedById  String?
  liftedBy    User?     @relation("BanLifter", fields: [liftedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([subjectId])
}

// ─────────────────────────────────────────────────────────────
// Positionen & Formular
// ─────────────────────────────────────────────────────────────

/// Bewerbungsart (heute nur "team", später z. B. "whitelist", "fraktion")
model ApplicationType {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String?
  active      Boolean       @default(true)
  positions   Position[]
  sections    FormSection[]
  createdAt   DateTime      @default(now())
}

model Position {
  id                   String          @id @default(cuid())
  typeId               String
  type                 ApplicationType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  slug                 String          @unique
  title                String
  tagline              String
  description          String
  tasks                String[]
  requirements         String[]
  icon                 String          @default("users")
  status               PositionStatus  @default(OPEN)
  sortOrder            Int             @default(0)
  minAge               Int?
  cooldownDays         Int?
  acceptRoleId         String?
  /// Automatisch öffnen/schließen (täglicher Cron) und Höchstzahl an Bewerbungen
  opensAt              DateTime?
  closesAt             DateTime?
  maxApplications      Int?
  /// Regel-Quiz: Mindestpunktzahl (nur Hinweis fürs Team, kein Ausschluss)
  quizMinScore         Int?
  /// Vorlage fürs Gesprächsprotokoll (leer = Standard aus den Einstellungen)
  interviewQuestions   String[]        @default([])
  /// Vier-Augen-Prinzip: Annahme erst ab so vielen Pro-Stimmen (null = aus)
  minProVotes          Int?
  /// Vier-Augen-Prinzip: Annahme nur durch Admins
  requireAdminApproval Boolean         @default(false)
  /// Zuständigkeit: nur Teammitglieder mit einer dieser Discord-Rollen sehen die Bewerbungen (leer = alle)
  teamRoleIds          String[]        @default([])
  /// Eigener Bewertungsbogen: je Zeile „Kriterium | Hinweis“ (leer = Standard-Kriterien)
  ratingCriteria       String[]        @default([])
  /// Kontingent: so viele Plätze – sind sie mit Annahmen belegt, schließt die Stelle automatisch (null = unbegrenzt)
  seats                Int?
  /// Bei Annahme vor den Discord-Namen setzen, z. B. „[Support]“ (leer = Name bleibt)
  nickPrefix           String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  sections     FormSection[]
  applications Application[]

  @@index([typeId, status])
}

/// Formular-Schritt. positionId = null → allgemeiner Schritt (für alle Positionen, nur einmal pro Person).
model FormSection {
  id          String          @id @default(cuid())
  /// Eindeutiger Schlüssel (z. B. "about", "support.fach") – eindeutig, sobald gesetzt
  key         String?         @unique
  archived    Boolean         @default(false)
  typeId      String
  type        ApplicationType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  positionId  String?
  position    Position?       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int             @default(0)
  questions   Question[]
  createdAt   DateTime        @default(now())

  @@index([typeId, positionId])
}

model Question {
  id            String       @id @default(cuid())
  /// Eindeutiger Schlüssel (z. B. "about_me", "support.newbie") – eindeutig, sobald gesetzt
  key           String?      @unique
  sectionId     String
  section       FormSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label         String
  helpText      String?
  placeholder   String?
  type          QuestionType
  required      Boolean      @default(true)
  minLength     Int?
  maxLength     Int?
  minValue      Int?
  maxValue      Int?
  options       String[]
  /// Nur bei QUIZ: die richtige Option – wird NIE an Bewerber ausgeliefert
  correctOption String?
  sortOrder     Int          @default(0)
  archived      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([sectionId])
}

// ─────────────────────────────────────────────────────────────
// Bewerbungen
// ─────────────────────────────────────────────────────────────

model Application {
  id         String            @id @default(cuid())
  /// Eindeutig, sobald gesetzt (Entwürfe haben noch keine – NULL zählt in Postgres nicht als Duplikat).
  /// Zusätzlich in der Migration: höchstens eine offene Bewerbung pro Person und Position.
  publicId   String?           @unique
  userId     String
  user       User              @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  positionId String
  position   Position          @relation(fields: [positionId], references: [id], onDelete: Restrict)
  status     ApplicationStatus @default(DRAFT)

  age             Int?
  /// Entwurfsdaten (Autosave): { [questionId]: value }
  draftData       Json      @default("{}")
  draftStep       Int       @default(0)
  /// Erinnerung an den liegengebliebenen Entwurf wurde verschickt (höchstens einmal)
  draftRemindedAt DateTime?
  confirmations   Json?
  consentVersion  String?
  consentAt       DateTime?

  submittedAt             DateTime?
  firstReviewedAt         DateTime?
  decidedAt               DateTime?
  decidedById             String?
  decidedBy               User?     @relation("Decider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Teammitglied, das die Bewerbung betreut ("geclaimt")
  claimedById             String?
  claimedBy               User?     @relation("Claimer", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt               DateTime?
  /// Rückzug während der Bearbeitung: Grund des Bewerbers, Team kann noch nachfragen
  withdrawReason          String?
  withdrawnInReview       Boolean   @default(false)
  /// Team hat den Rückzug bestätigt (danach keine Rückfragen mehr, raus aus dem Dashboard)
  withdrawAckAt           DateTime?
  withdrawAckById         String?
  interviewAt             DateTime?
  interviewNote           String?
  /// Für diesen Termin wurde die Erinnerungs-DM schon verschickt
  interviewRemindedFor    DateTime?
  /// Bewerber hat den Discord verlassen – Bot hat im Portal Bescheid gegeben (zurückgesetzt, wenn wieder da)
  guildLeftNotifiedAt     DateTime?
  /// Discord-Thread zur Bewerbung im Bewerbungs-Kanal (Team-Diskussion)
  discordThreadId         String?
  /// Testbewerbung (Admin → Testbewerbungen): keine DMs, nicht in Statistik/Höchstzahl
  isTest                  Boolean   @default(false)
  /// Szenario der Testbewerbung (lib/setup/test-applications.ts)
  testScenario            String?
  /// Rückfrage mit Frist: Team wartet seit … auf eine Antwort (null = keine offene Rückfrage)
  awaitingReplySince      DateTime?
  awaitingRemindedAt      DateTime?
  /// Nicht zum Gespräch erschienen (Anzahl)
  noShowCount             Int       @default(0)
  /// Discord-Server-Event zum Gespräch
  discordEventId          String?
  /// Geplante Erinnerungs-DM an den Betreuer vor dem Gespräch (Outbox-Job)
  teamReminderJobId       String?
  /// Auf dem Discord gebannt (erkannt bei der Mitgliedschaftsprüfung)
  guildBannedAt           DateTime?
  guildBanReason          String?
  /// Bewerber hat Antworten nachgereicht
  amendedAt               DateTime?
  /// Einarbeitung nach der Annahme: { [Punkt]: { at, by } }
  onboarding              Json      @default("{}")
  probationUntil          DateTime?
  /// Pings (Bot-Log/Thread) zu neuen Bewerber-Nachrichten bis dahin stumm
  mutedUntil              DateTime?
  /// Erinnerung an den Betreuer wegen liegengebliebenem Claim (einmal pro Claim)
  claimRemindedAt         DateTime?
  /// Annahme hat einen „freien Platz“ der Stelle belegt (nur dann gibt Zurücknehmen ihn wieder frei)
  seatTakenAt             DateTime?
  /// Sprachkanal-Erkennung (Worker): Bewerber erstmals im Gesprächskanal / zuletzt verlassen
  voiceJoinedAt           DateTime?
  voiceLeftAt             DateTime?
  /// Warteraum-Ping an den Betreuer verschickt (einmal pro Termin)
  waitingPingAt           DateTime?
  /// Bewerber hat gemeldet: bis dahin nicht erreichbar (Rückfrage-Erinnerung und Frist pausieren)
  applicantAwayUntil      DateTime?
  /// Probezeit-Abschluss: PASSED (bestanden) | ENDED (beendet); verlängern setzt nur probationUntil neu
  probationResult         String?
  probationDecidedAt      DateTime?
  probationDecidedById    String?
  /// Erinnerung „Probezeit endet“ an Betreuer verschickt (für dieses Enddatum)
  probationRemindedFor    DateTime?
  /// Pate für neue Teammitglieder (User-ID) + Rückmeldung nach 14 Tagen { rating: "good" | "help", note, by, at }
  mentorId                String?
  mentorFeedback          Json?
  mentorRemindedAt        DateTime?
  rejectionReason         String?
  /// Feste Kategorie des Absagegrunds (lib/applications/rejection.ts) – für die Statistik
  rejectionCategory       String?
  /// Regel-Quiz: richtige Antworten / Anzahl Quizfragen (beim Absenden ausgewertet)
  quizCorrect             Int?
  quizTotal               Int?
  /// Zusätzliche Gesprächsfragen nur für diese Bewerbung (z. B. aus den KI-Gesprächsfragen)
  interviewExtraQuestions String[]  @default([])

  confirmationDmStatus  DeliveryStatus?
  /// Automatische Hinweise (kein Score!): [{ code, message }]
  flags                 Json            @default("[]")
  aiSummary             String?
  aiSummaryAt           DateTime?
  /// KI-Einordnung (beschreibende Kategorien, kein Ranking)
  aiTags                String[]        @default([])
  aiTaggedAt            DateTime?
  /// KI-Punkte für den Bewertungsbogen: { scores, reasons, fazit } oder { blocked } – nur Einschätzung
  aiRating              Json?
  aiRatedAt             DateTime?
  /// Admin hat KI-Punkte trotz älterer Einwilligung freigegeben (Bewerber hat zugestimmt)
  aiConsentOverrideAt   DateTime?
  aiConsentOverrideById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers         Answer[]
  uploads         Upload[]
  statusChanges   StatusChange[]
  votes           Vote[]
  comments        Comment[]
  messages        Message[]
  ratings         Rating[]
  slot            InterviewSlot?
  feedback        Feedback?
  interviewNotes  InterviewNote[]
  interviewChecks InterviewCheck[]

  @@index([publicId])
  @@index([status])
  @@index([positionId])
  @@index([userId])
  @@index([submittedAt])
}

/// Eingereichte Antwort inkl. Snapshot der Frage (Formular-Änderungen verfälschen alte Bewerbungen nicht)
model Answer {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String?
  sectionTitle  String
  label         String
  type          QuestionType
  value         Json
  /// Nur bei QUIZ: richtig beantwortet? (beim Absenden ausgewertet)
  correct       Boolean?
  sortOrder     Int          @default(0)

  @@index([applicationId])
}

model Upload {
  id            String       @id @default(cuid())
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String?
  fileName      String
  mime          String
  size          Int
  width         Int
  height        Int
  sha256        String
  /// Bild als WebP (ohne Metadaten) – in der DB, damit es auf Vercel ohne Dateisystem läuft
  data          Bytes
  createdAt     DateTime     @default(now())

  @@index([applicationId])
  @@index([ownerId])
}

model StatusChange {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          ApplicationStatus?
  to            ApplicationStatus
  actorId       String?
  actor         User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

model Vote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  value         VoteValue
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([applicationId, userId])
}

/// Bewertungsbogen: Punkte 1–5 pro Kriterium, eine Bewertung pro Teammitglied und Bewerbung
model Rating {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { [Kriterium]: 1..5 }
  scores        Json        @default("{}")
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([applicationId, userId])
}

/// Freier Gesprächstermin, den Bewerber im Status „Gespräch“ selbst buchen
model InterviewSlot {
  id            String       @id @default(cuid())
  startsAt      DateTime
  durationMin   Int          @default(30)
  note          String?
  createdById   String?
  createdBy     User?        @relation("SlotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  bookedAt      DateTime?
  createdAt     DateTime     @default(now())

  @@index([startsAt])
}

/// Gesprächsprotokoll: Notiz zu einer Frage (question = "" → Gesamtfazit). Mehrere Teammitglieder ergänzen, nichts wird überschrieben.
model InterviewNote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      String
  body          String
  authorId      String?
  author        User?       @relation("InterviewNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

/// Gesprächsprotokoll: Frage abgehakt (eine pro Bewerbung und Frage)
model InterviewCheck {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      String
  checkedById   String?
  checkedBy     User?       @relation("InterviewCheckAuthor", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt     DateTime    @default(now())

  @@unique([applicationId, question])
}

/// Rückmeldung des Bewerbers zum Ablauf (nach der Entscheidung, freiwillig)
model Feedback {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
}

model Comment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Message {
  id             String           @id @default(cuid())
  applicationId  String
  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  authorId       String?
  author         User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  templateIds    String[]
  /// Vom Teammitglied bewusst als "Nordverkehr-Team" gesendet (Name bleibt intern sichtbar)
  asTeam         Boolean          @default(false)
  deliveryStatus DeliveryStatus   @default(NOT_SENT)
  deliveryError  String?
  sentAt         DateTime?
  readAt         DateTime?
  /// Verdacht auf Manipulationsversuch (Prompt Injection) – nur Hinweis fürs Team
  flagged        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  outboxJobs     OutboxJob[]

  @@index([applicationId, createdAt])
}

model MessageTemplate {
  id          String           @id @default(cuid())
  category    TemplateCategory
  title       String
  body        String
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  /// Nur bei diesen Bewerbungsarten anzeigen („team“, „whitelist“, „beta“) – leer = bei allen
  kinds       String[]         @default([])
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// System
// ─────────────────────────────────────────────────────────────

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String
  model        String
  inputTokens  Int
  outputTokens Int
  /// Kosten in Millionstel USD (Ganzzahl, keine Rundungsfehler)
  costMicroUsd Int
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model OutboxJob {
  id            String       @id @default(cuid())
  type          OutboxType
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5)
  runAt         DateTime     @default(now())
  lockedAt      DateTime?
  lastError     String?
  result        Json?
  messageId     String?
  message       Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  applicationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, runAt])
}

model Counter {
  key   String @id
  value Int
}

/// Bewerbungsrunde: Zeitraum (optional nur eine Stelle) mit Zielanzahl – für die Auswertung
model ApplicationRound {
  id          String   @id @default(cuid())
  name        String
  /// leer = alle Stellen
  positionId  String?
  startsAt    DateTime
  endsAt      DateTime
  /// Ziel: so viele Annahmen
  target      Int?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([startsAt])
}

/// Ideen-Sammlung: Ideen, Feedback und Fehlermeldungen von allen (Bewerber und Team).
/// Admins sichten sie im Admin-Bereich und entscheiden, ob etwas eingebaut wird.
enum SuggestionKind {
  IDEA
  FEEDBACK
  BUG
}

enum SuggestionStatus {
  NEW
  REVIEWING
  PLANNED
  DONE
  DECLINED
}

model Suggestion {
  id          String           @id @default(cuid())
  kind        SuggestionKind
  title       String
  body        String
  /// Bei Fehlern: wo es passiert ist (Seite/Adresse, frei eingegeben)
  location    String?
  status      SuggestionStatus @default(NEW)
  /// Antwort der Admins – sieht auch die Person, die es eingereicht hat
  adminNote   String?
  /// Konto gelöscht → Einreichungen werden mitgelöscht (können persönliche Angaben enthalten)
  authorId    String?
  author      User?            @relation("SuggestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  handledById String?
  handledBy   User?            @relation("SuggestionHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([authorId])
}

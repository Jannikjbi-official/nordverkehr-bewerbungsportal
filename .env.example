# ─────────────────────────────────────────────────────────────
# Bewerbungsportal – Umgebungsvariablen
# Kopieren nach .env (lokal) bzw. in Vercel → Settings → Environment Variables.
# NIEMALS echte Werte committen.
# ─────────────────────────────────────────────────────────────

# Öffentliche URL des Portals (ohne Slash am Ende)
NEXT_PUBLIC_APP_URL="https://bewerbung.example.org"
# Hauptseite eures Servers (Footer, erlaubte Links in KI-Antworten)
NEXT_PUBLIC_MAIN_SITE_URL="https://example.org"
# Dauerhafter Einladungslink zu eurem Discord
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/DEIN-CODE"
# Regelwerk (optional, Standard: <Hauptseite>/regeln)
# NEXT_PUBLIC_RULES_URL="https://example.org/regeln"

# ─── Datenbank: PostgreSQL (z. B. Neon) ───
# Vercel + Neon-Integration: setzt DATABASE_URL, DATABASE_URL_UNPOOLED und
# DATABASE_POSTGRES_PRISMA_URL – alles wird automatisch erkannt.
# Neon von Hand: DATABASE_URL = Verbindung „pooled“, DATABASE_URL_UNPOOLED = „direct“ (für Migrationen).
# Lokal:  npm run db:dev  →
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/nordverkehr"
# DATABASE_URL_UNPOOLED=""
# Nur für den einmaligen Umzug von einer alten MongoDB (Admin-Bereich → „Daten aus MongoDB übernehmen“):
# DATABASE_URL_MONGODB_URI=""

# ─── Auth.js / Discord-OAuth ───
# Secret erzeugen: npx auth secret   (oder: openssl rand -base64 32)
AUTH_SECRET=""
# Discord Developer Portal → Applications → OAuth2
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Hinter Proxy/Vercel: Host-Header vertrauen
AUTH_TRUST_HOST="true"

# ─── Discord-Bot (Rollenprüfung, DMs, Log-Channel, Rollenvergabe) ───
DISCORD_BOT_TOKEN=""
# Server-ID (Rechtsklick auf den Server → ID kopieren; Entwicklermodus nötig)
DISCORD_GUILD_ID=""
# Nur wer diese Rolle hat, kommt in den Team-Bereich
TEAM_ROLE_ID=""
# Pflicht für Einstellungen, Formular-Builder, Sperrfristen, KI-Budget
ADMIN_ROLE_ID=""
# Channel für "Neue Bewerbung"-Posts (optional)
DISCORD_LOG_CHANNEL_ID=""
# Wie lange eine Rollenprüfung gecacht wird (Sekunden)
ROLE_CACHE_TTL_SECONDS="60"

# ─── KI (optional) – Anthropic Claude ───
ANTHROPIC_API_KEY=""
AI_MODEL_DEFAULT="claude-sonnet-5-5"
AI_MODEL_FAST="claude-haiku-5-5"

# Präfix der Bewerbungs-IDs (NV-2026-0001)
PUBLIC_ID_PREFIX="NV"

# ─── NUR lokal: Login als Seed-Nutzer ohne Discord (in Produktion wirkungslos) ───
# DEV_LOGIN="true"
